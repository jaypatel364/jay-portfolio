# ── Site URL (required for SEO: canonical URLs, OG tags, sitemap)
# Production domain, no trailing slash. Homepage canonical is built as this + "/".
NEXT_PUBLIC_SITE_URL=https://jaypateldev.com

# ── Sanity CMS (blog preview branch — optional until /blog is used)
# Project: Portfolio (manage.sanity.io). Dataset is public-read for published docs.
NEXT_PUBLIC_SANITY_PROJECT_ID=xxxxxxx
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-08-01
# Viewer token — only needed to read unpublished drafts (`drafts.*` docs).
# Create at: https://www.sanity.io/manage/project/xxxxxxx/api#tokens
# SANITY_API_READ_TOKEN=
# Show posts without publishedAt (on by default in `next dev`).
# Set true on Vercel Preview if you deploy this branch.
# BLOG_PREVIEW=true

# ── Sanity Webhook — On-demand ISR revalidation
# Shared secret that authenticates POST /api/revalidate/sanity.
# Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Add the same value to:
#   - This file (.env.local for local dev)
#   - Vercel UAT environment variables
#   - Vercel Production environment variables
# Configure the Sanity webhook at:
#   https://www.sanity.io/manage/project/xxxxxxx/api#webhooks
#   URL:     https://<your-domain>/api/revalidate/sanity
#   Method:  POST
#   Trigger: Create, Update, Delete
#   Filter:  _type in ["post", "blogSettings", "category"]
#   Header:  x-sanity-secret: <this-secret>
#   Projection (Sanity webhook "Projection" field):
#     { _id, _type, "slug": slug.current, "operation": delta::operation() }
# DO NOT reuse SANITY_API_READ_TOKEN for this value.
SANITY_REVALIDATE_SECRET=your-random-secret-here

# ── Search Console / Bing (optional — HTML tag verification)
# Paste the token from Google Search Console → Settings → Ownership verification → HTML tag.
# Example content="abc123" → use only abc123, not the full meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Groq AI (required for the chatbot)
# Get your free key at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Upstash Redis (recommended on Vercel — shared rate limits for chat + contact)
# Create a free database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Sentry (optional — error monitoring for API routes + UI)
# Create a project at https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=your-auth-token

# ── Contact form (required: MongoDB and/or Resend — fail-closed if neither is set)
# At least one backend must work or POST /api/contact returns 503.

# ── MongoDB (optional if Resend is configured — stores contact form submissions)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio

# ── Resend — contact email. https://resend.com (3,000 emails/month free)
# Verify jaypateldev.com in Resend, then use a from-address on that domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="Jay Patel <noreply@jaypateldev.com>"
CONTACT_NOTIFY_TO=you@gmail.com

# ── Google reCAPTCHA v2 Checkbox ("I'm not a robot") — production only
# Hidden on localhost / `next dev` / Vercel preview. Required on jaypateldev.com.
# https://www.google.com/recaptcha/admin — choose reCAPTCHA v2 → "I'm not a robot" Checkbox
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lcxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RECAPTCHA_SECRET_KEY=6Lcxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Optional: salt for hashing client IPs in rate-limit keys (privacy)
# IP_HASH_SALT=change-me

